# Supabase project settings — find these in your Supabase dashboard under
# Project Settings → API. See docs/SETUP.md for the full walkthrough.

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" public API key (safe to expose to the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
